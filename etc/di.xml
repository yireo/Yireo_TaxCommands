<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="yireo_taxcommands_tax_rate_list" xsi:type="object">
                    Yireo\TaxCommands\Console\Command\TaxRateListCommand
                </item>
                <item name="yireo_taxcommands_tax_rate_create" xsi:type="object">
                    Yireo\TaxCommands\Console\Command\TaxRateCreateCommand
                </item>
                <item name="yireo_taxcommands_tax_calculation_create" xsi:type="object">
                    Yireo\TaxCommands\Console\Command\TaxCalculationCreateCommand
                </item>
                <item name="yireo_taxcommands_tax_class_list_command" xsi:type="object">
                    Yireo\TaxCommands\Console\Command\TaxClassListCommand
                </item>
                <item name="yireo_taxcommands_tax_calculation_autoapply_command" xsi:type="object">
                    Yireo\TaxCommands\Console\Command\TaxCalculationAutoapplyCommand
                </item>
            </argument>
        </arguments>
    </type>

    <virtualType name="Yireo\TaxCommands\Logger\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/yireo_tax_commands.log</argument>
        </arguments>
    </virtualType>

    <virtualType name="Yireo\TaxCommands\Logger\Logger" type="Monolog\Logger">
        <arguments>
            <argument name="name" xsi:type="string">yireo_tax_commands</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Yireo\TaxCommands\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Yireo\TaxCommands\Logger\ChangeLogger">
        <arguments>
            <argument name="logger" xsi:type="object">Yireo\TaxCommands\Logger\Logger</argument>
        </arguments>
    </type>
</config>
